{
  "openapi": "3.0.3",
  "info": {
    "title": "Kenma Scout — laboratorio intencionalmente vulnerable",
    "version": "1.0.0",
    "description": "Burp Suite Day Perú 2026. Datos ficticios. No usar en producción. La caché del authorizer vulnerable dura 300 s por token y reutiliza Allow o Deny para todos los verbos/rutas. El modo fixed desactiva esa caché y aplica autorización de dominio. CloudFront no cachea /api/*. Los errores de Gateway pueden usar message.",
    "contact": {
      "name": "Luis Valdivia Humareda"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000/api",
      "description": "Node o Docker local"
    },
    {
      "url": "https://{distribution}/api",
      "description": "CloudFront (output CloudFrontApiUrl)",
      "variables": {
        "distribution": {
          "default": "example.cloudfront.net"
        }
      }
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
