  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "team": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "position": {
            "type": "string"
          },
          "bio": {
            "type": "string"
          },
          "number": {
            "type": "integer"
          }
        },
        "additionalProperties": true,
        "required": [
          "id",
          "username",
          "name",
          "team",
          "role",
          "bio"
        ]
      },
      "Report": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "team": {
            "type": "string"
          },
          "ownerId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "opponent": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "formation": {
            "type": "string"
          },
          "risk": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "play": {
            "type": "string"
          },
          "weakness": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "metrics": {
            "type": "object",
            "properties": {
              "attack": {
                "type": "number"
              },
              "defense": {
                "type": "number"
              },
              "serve": {
                "type": "number"
              }
            },
            "additionalProperties": false,
            "required": [
              "attack",
              "defense",
              "serve"
            ]
          },
          "points": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "additionalProperties": true,
        "required": [
          "id",
          "team",
          "ownerId",
          "title",
          "play"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "Message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Login": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        },
        "additionalProperties": false,
        "required": [
          "username",
          "password"
        ]
      },
      "Token": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "integer"
          }
        },
        "additionalProperties": false,
        "required": [
          "accessToken",
          "expiresIn"
        ]
      },
      "ProfilePatch": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "bio": {
            "type": "string",
            "maxLength": 280
          }
        },
        "additionalProperties": true,
        "description": "fixed acepta únicamente name y bio. vulnerable permite campos adicionales, incluidos role y team (mass assignment intencional)."
      },
      "Config": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "vulnerable",
              "fixed"
            ]
          },
          "runtime": {
            "type": "string",
            "enum": [
              "local",
              "aws"
            ]
          },
          "auth": {
            "type": "string"
          },
          "localControls": {
            "type": "boolean"
          },
          "version": {
            "type": "string"
          }
        },
        "additionalProperties": true,
        "required": [
          "mode",
          "runtime",
          "localControls"
        ]
      },
      "ReportList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Report"
            }
          },
          "total": {
            "type": "integer"
          }
        },
        "additionalProperties": false,
        "required": [
          "items",
          "total"
        ]
      },
      "Teams": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "city": {
                  "type": "string"
                },
                "motto": {
                  "type": "string"
                },
                "animal": {
                  "type": "string"
                },
                "color": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "items"
        ]
      },
      "Deleted": {
        "type": "object",
        "properties": {
          "deleted": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "deleted"
        ]
      },
      "Message": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "Mode": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "vulnerable",
              "fixed"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "mode"
        ]
      }
    }
  }
}
